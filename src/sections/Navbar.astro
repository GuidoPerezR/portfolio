---
import { NAV_CONTENT } from '@/const/NavLinks';
import type { Locale } from '@/types/Locale';
interface Props {
  locale: Locale;
}
const { locale = 'es' }: Props = Astro.props;

const content = NAV_CONTENT[locale];
---

<nav
  class="fixed top-1/2 flex w-fit -translate-y-1/2 flex-col gap-8 pl-6 font-spartan md:pl-24"
>
  {
    content.map((link) => {
      const isCvDownload =
        link.title === 'Descargar CV' || link.title === 'Download CV';

      return (
        <a
          href={link.href}
          data-description={link.description}
          class="nav-link w-fit text-2xl font-semibold text-hover-nav uppercase transition-colors duration-300 hover:text-hover-nav md:text-light-gray-text"
          transition:name={link.id}
          download={isCvDownload ? '' : undefined}
          aria-label={`Ir a ${link.title}`}
        >
          {link.title}
        </a>
      );
    })
  }
</nav>

<span
  id="nav-description"
  class="fixed bottom-44 z-10 hidden pl-24 font-spartan text-xl font-semibold text-white opacity-0 transition-opacity duration-300 md:block"
>
</span>

<script>
  function setNavDescriptions() {
    const links = document.querySelectorAll('.nav-link');
    const description = document.getElementById('nav-description');

    links.forEach((link) => {
      link.addEventListener('mouseenter', () => {
        const desc = link.getAttribute('data-description');
        if (description && desc) {
          description.textContent = desc;
          description.style.opacity = '1';
        }
      });

      link.addEventListener('mouseleave', () => {
        if (description) {
          description.style.opacity = '0';
        }
      });
    });
  }

  setNavDescriptions();

  document.addEventListener('astro:page-load', setNavDescriptions);
</script>
