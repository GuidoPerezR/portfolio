---
import Back from './icons/Back.astro';
const { title, id, lang } = Astro.props;

const href = lang === 'en' ? '/en' : '/';
const linkText = lang === 'en' ? 'Back' : 'Volver';
---

<section
  class="flex min-h-dvh w-full flex-col items-center justify-center bg-dark-bg px-6 py-12 font-spartan text-white md:p-16"
>
  <div class="flex w-full max-w-[1920px] flex-1 flex-col">
    <header class="flex items-center gap-6">
      <h1
        class="flex-shrink-0 text-4xl font-semibold whitespace-nowrap uppercase"
        transition:name={id}
      >
        {title}
      </h1>
      <hr class="w-full -translate-y-0.5 text-light-gray" />
    </header>
    <slot />
    <footer>
      <hr class="w-full text-light-gray" />
      <div class="mt-6 flex w-full justify-center">
        <a
          class="group flex cursor-pointer items-center gap-2 text-xl font-bold text-light-gray uppercase transition-colors duration-300 hover:text-hover-nav md:text-2xl"
          href={href}
          ><Back
            class="size-8 transition-transform duration-300 group-hover:-translate-x-1.5 md:size-9"
          />
          {linkText}</a
        >
      </div>
    </footer>
  </div>
</section>
