---
import { TECH_ICONS } from '@/const/Tecnologies';
import ExternalLink from '@/components/icons/ExternalLink.astro';
import Github from '@/components/icons/Github.astro';

const { id, title, image, long_desc, technologies, link, github } = Astro.props;

type TechIconKey = keyof typeof TECH_ICONS;

const isTechIconKey = (tech: string): tech is TechIconKey => {
  return tech in TECH_ICONS;
};

const getTechIcon = (tech: string) => {
  return isTechIconKey(tech) ? TECH_ICONS[tech] : undefined;
};
---

<article
  id={`project-detail-${id}`}
  class="project-detail w-full max-w-4xl flex-col gap-4 transition-opacity duration-300 lg:hidden lg:pl-4 lg:opacity-0"
>
  <div>
    <h2 class="text-3xl font-bold text-white">{title}</h2>
    <div class="mt-6 w-full md:h-80">
      <a href={link} target="_blank" rel="noopener noreferrer" class="block h-full w-full">
        <img src={image} alt={title} class="h-full w-full object-cover" />
      </a>
    </div>
  </div>
  <div class="mt-4 flex flex-col md:items-end">
    <p class="max-w-2xl text-lg text-pretty md:text-right">{long_desc}</p>
    <div class="mt-4 flex flex-wrap gap-2 md:justify-end">
      {
        technologies?.map((tech: string) => {
          const Icon = getTechIcon(tech);
          return (
            <span class="flex items-center gap-1.5 bg-white/10 px-3 py-1.5 text-white">
              {tech} {Icon && <Icon class="size-5" />}
            </span>
          );
        })
      }
    </div>
    <div class="mt-4 flex flex-col gap-6 md:flex-row md:items-center">
      <a
        href={link}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden md:flex items-center gap-2 text-lg text-hover-nav transition-colors duration-300 hover:text-hover-nav md:text-light-gray"
        >{link}<ExternalLink class="size-4" /></a
      >
      <a
        href={github}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-2 text-lg text-hover-nav transition-colors duration-300 hover:text-hover-nav md:text-light-gray"
        >Repositorio<Github class="size-6" /></a
      >
    </div>
  </div>
</article>
