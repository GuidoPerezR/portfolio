---
import { TECHNOLOGIES } from '@/const/Tecnologies';
import { ABOUT_CONTENT } from '@/const/AboutContent';
import type { Locale } from '@/types/Locale';

interface Props {
  locale: Locale;
}

const { locale = 'es' }: Props = Astro.props;
const content = ABOUT_CONTENT[locale];
---

<div class="mt-6 flex flex-1 flex-col-reverse md:mt-12 md:flex-row">
  <div class="my-6 w-full md:my-0">
    <div class="flex flex-col gap-4 font-medium">
      <span class="text-2xl">{content.technologiesLabel}</span>
      <ul
        class="flex flex-wrap justify-center gap-4 md:flex-col md:text-light-gray"
      >
        {
          TECHNOLOGIES.map(({ name, color, icon: Icon }) => (
            <li
              class={`group flex w-fit cursor-auto items-center gap-2 text-xl transition-colors duration-300 will-change-transform md:text-2xl ${color}`}
            >
              {name}
              <Icon class="size-8 transition-all duration-200 group-hover:translate-x-0 group-hover:translate-y-0 group-hover:rotate-0 group-hover:opacity-100 md:-translate-x-8 md:translate-y-10 md:rotate-90 md:opacity-0" />
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <div class="w-full max-w-3xl">
    <div class="flex flex-col items-end">
      <header class="flex w-full items-center md:pl-[68px]">
        <h2 class="text-2xl font-semibold">Guido Perez Ruiz</h2>
      </header>
      <div class="mt-6 w-full md:h-72 md:w-[700px]">
        <img
          src="/images/me3.jpeg"
          alt={content.imageAlt}
          class="h-full w-full object-cover object-top"
        />
      </div>
    </div>
    <div class="mt-6 flex w-full flex-col items-end gap-4">
      {
        content.paragraphs.map((paragraph) => (
          <p class="max-w-xl text-xl text-pretty md:text-right">
            {paragraph.prefix}
            <span class="font-semibold text-astro">{paragraph.highlight}</span>
            {paragraph.suffix}
          </p>
        ))
      }
    </div>
  </div>
</div>
