---
const { id, title, image, short_desc, date } = Astro.props;
---

<article
  class="project-item flex w-full cursor-pointer flex-col text-light-gray transition-colors duration-300 hover:bg-hover-card hover:text-hover-nav 2xl:h-36 xl:flex-row"
  data-project-id={id}
>
  <div class="w-full flex-1">
    <img src={image} alt="" class="h-full w-full object-cover" />
  </div>
  <div class="flex w-full flex-2 items-center justify-between gap-2 p-4">
    <div>
      <span class="text-2xl font-bold uppercase">{title}</span>
      <p class="mt-1.5 text-lg text-pretty">{short_desc}</p>
    </div>
    <div>
      <span class="text-xl font-bold uppercase">{date}</span>
    </div>
  </div>
</article>
