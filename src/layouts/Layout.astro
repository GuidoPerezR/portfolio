---
import '@/styles/global.css';
import '@fontsource-variable/league-spartan';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'Guidzero | Desarrollador Web | Portafolio',
  description = 'Portafolio de Guidzero. Desarollador Front-End',
  image = '/images/og-image.png',
} = Astro.props;
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/images/logo-g0.png" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:image" content={new URL(image, Astro.url)} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.url)} />

    <ClientRouter />
  </head>
  <body class="relative min-h-dvh w-full bg-black">
    <video
      id="bg-video"
      autoplay
      loop
      muted
      transition:persist="bg-video"
      class="fixed top-0 left-0 -z-40 h-full w-full mask-radial-from-25% mask-radial-at-right object-cover object-top md:mask-radial-from-25% md:mask-circle md:mask-radial-at-center"
    >
      <source src="/videos/salida.webm" type="video/webm" />
      <source src="/videos/sea.mp4" type="video/mp4" />
    </video>

    <slot />
  </body>
</html>
