---
import '@/styles/global.css';
import '@fontsource-variable/league-spartan';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'Guidzero | Web Developer | Portfolio',
  description = "Guidzero's Portfolio. Front-End Developer",
  image = '/images/og-image-en.png',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/images/logo-g0.png" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:image" content={new URL(image, Astro.url)} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.url)} />

    <ClientRouter />
  </head>
  <body class="relative min-h-dvh w-full bg-black">
    <video
      transition:persist="bg-video"
      id="bg-video"
      src="/videos/sea.mp4"
      autoplay
      loop
      muted
      class="fixed top-0 left-0 -z-40 h-full w-full mask-radial-from-25% mask-circle mask-radial-at-center object-cover object-top"
    ></video>

    <slot />
  </body>
</html>
