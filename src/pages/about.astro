---
import Layaout from '@/layouts/Layout.astro';
import PageContainer from '@/components/PageContainer.astro';
import { TECHNOLOGIES } from '@/const/Tecnologies';

const pageInfo = {
  title: 'Sobre mí',
  id: 'about',
};
---

<Layaout>
  <PageContainer {...pageInfo}>
    <div class="mt-12 flex flex-1">
      <div class="w-full">
        <div class="flex flex-col gap-4 text-2xl font-medium">
          <span>Tecnologías</span>
          <ul class="flex flex-col gap-4 text-light-gray">
            {
              TECHNOLOGIES.map(({ name, color, icon: Icon }) => (
                <li
                  class={`group flex w-fit cursor-auto items-center gap-2 transition-colors duration-300 will-change-transform ${color}`}
                >
                  {name}
                  <Icon class="size-8 -translate-x-8 translate-y-10 rotate-90 opacity-0 transition-all duration-200 group-hover:translate-x-0 group-hover:translate-y-0 group-hover:rotate-0 group-hover:opacity-100" />
                </li>
              ))
            }
          </ul>
        </div>
      </div>
      <div class="w-full max-w-3xl">
        <div class="flex flex-col items-end">
          <header class="flex w-full items-center pl-[68px]">
            <h2 class="text-2xl font-semibold">Guido Perez Ruiz</h2>
          </header>
          <div class="mt-6 h-72 w-[700px]">
            <img
              src="/images/me3.jpeg"
              alt=""
              class="h-full w-full object-cover object-top"
            />
          </div>
        </div>
        <div class="mt-6 flex w-full flex-col items-end gap-4">
          <p class="max-w-xl text-right text-lg">
            Desarrollador web con <span class="font-semibold text-astro"
              >2 años de experiencia</span
            >. Me enfoco en el desarrollo <span class="font-semibold text-astro"
              >Front-end</span
            >, utilizando tecnologías como TypeScript, React y Tailwind CSS.
          </p>
          <p class="max-w-xl text-right text-lg">
            Me gusta crear sitios que puedan <span
              class="font-semibold text-astro">resolver la necesidad</span
            > del cliente de forma <span class="font-semibold text-astro"
              >atractiva, optimizada</span
            > y brindando la mejor experiencia de usuario.
          </p>
          <p class="max-w-xl text-right text-lg">
            Siempre estoy <span class="font-semibold text-astro"
              >mejorando mis habilidades</span
            > para poder brindar una nueva experiencia en cada sitio que realizo.
          </p>
        </div>
      </div>
    </div>
  </PageContainer>
</Layaout>
