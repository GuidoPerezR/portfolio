---
import Layaout from '@/layouts/Layout.astro';
import PageContainer from '@/components/PageContainer.astro';
import AboutContent from '@/components/AboutContent.astro';
import { ABOUT_CONTENT } from '@/const/AboutContent';

const pageInfo = {
  title: ABOUT_CONTENT.en.title,
  id: 'about',
  lang: 'en',
};
---

<Layaout>
  <PageContainer {...pageInfo}>
    <AboutContent locale="en" />
  </PageContainer>
</Layaout>
