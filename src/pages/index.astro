---
import Layout from '../layouts/Layout.astro';
import Navbar from '@/sections/Navbar.astro';
---

<Layout>
  <Navbar locale="es" />

  <div
    class="fixed top-0 right-0 mt-4 flex justify-center gap-6 p-6 font-spartan text-xl text-light-gray-text"
  >
    <a
      href="/"
      class="transition-colors duration-300 hover:text-hover-nav"
      aria-label="Cambiar a Español">ES</a
    >
    <a
      href="/en"
      class="transition-colors duration-300 hover:text-hover-nav"
      aria-label="Cambiar a Ingles">EN</a
    >
  </div>
</Layout>
